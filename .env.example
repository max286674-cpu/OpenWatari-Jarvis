# Jarvis configuration — copy to `.env` and fill in. All keys are prefixed JARVIS_.
# Never commit the real .env (see .gitignore).

# ---- Identity: make this YOUR assistant (no code/persona edits needed) ----------------
# The persona file is a template; these fill it in. Defaults are generic; personalise here.
JARVIS_ASSISTANT_NAME=Watari                 # what your assistant calls itself
JARVIS_USER_NAME=                            # your name (blank = it won't use a name)
JARVIS_USER_ADDRESS=                         # how it addresses you: "sir", "boss", your name, or blank
JARVIS_UNDERSTOOD_LANGUAGES=English          # comma-list it can UNDERSTAND (STT)
JARVIS_REPLY_LANGUAGE=English                # the single language it always REPLIES in
JARVIS_USER_TZ=UTC                           # your IANA timezone, e.g. Europe/Berlin, America/New_York
JARVIS_PERSONA_FILE=jarvis.md                # which file in personality/ holds the persona template

# ---- Provider selection ---------------------------------------------------------------
# Cloud-first for quality; if a cloud provider can't be built it AUTO-FALLS-BACK to the local
# engine (voice_local_fallback). Set JARVIS_STT_PROVIDER=whisper if you speak Armenian/Ukrainian.
JARVIS_STT_PROVIDER=deepgram          # deepgram (cloud, accurate) | whisper | moonshine (local)
JARVIS_TTS_PROVIDER=elevenlabs        # elevenlabs (the voice) | piper | kokoro (local, offline)
JARVIS_VOICE_LOCAL_FALLBACK=true      # cloud fails -> use local engine (so the pipeline always comes up)
JARVIS_TTS_FALLBACK_PROVIDER=piper    # local TTS used if the cloud TTS can't be built
JARVIS_STT_FALLBACK_PROVIDER=whisper  # local STT used if the cloud STT can't be built
JARVIS_LLM_BACKEND=freellmapi         # Jarvis's OWN brain: freellmapi | ollama | openai
JARVIS_OPENCLAW_DELEGATION_ENABLED=true   # let Jarvis CONSULT the OpenClaw fleet as a tool

# ---- ElevenLabs: the voice you want Jarvis to have ------------------------------------
JARVIS_ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = lowest latency for streaming; eleven_turbo_v2_5 = a bit higher quality
JARVIS_ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- Deepgram: accurate streaming speech recognition ("understands me really well") ---
JARVIS_DEEPGRAM_API_KEY=
JARVIS_DEEPGRAM_MODEL=nova-3
# Multilingual understanding. Jarvis ALWAYS replies in English; this only sets which spoken
# languages he can understand. 'multi' = Deepgram nova-3 code-switch across English/French/
# German/Russian (low latency). Deepgram does NOT support Armenian, and Ukrainian isn't in 'multi'
# — to understand ALL SIX (incl. Armenian + Ukrainian) set JARVIS_STT_PROVIDER=whisper (local
# faster-whisper, auto-detect; heavier on a no-GPU CPU but covers everything).
JARVIS_DEEPGRAM_LANGUAGE=multi

# ---- Audio routing (speakers <-> headphones / AirPods) --------------------------------
# Where Jarvis plays his voice. Alias ("speakers" | "headphones" | "airpods"), a device-name
# fragment, or a numeric index. Blank = OS default. A voice command ("switch to my headphones")
# saves a preference that overrides this at next start. Input stays on the laptop mic so
# Bluetooth keeps high-quality A2DP output (using AirPods as the mic forces low-quality HFP).
JARVIS_AUDIO_OUTPUT_DEVICE=
# Pin the mic by NAME substring (survives Bluetooth index shuffles), or by index.
JARVIS_AUDIO_INPUT_DEVICE_NAME=
JARVIS_AUDIO_INPUT_DEVICE_INDEX=

# ---- Smart barge-in (interrupt Jarvis mid-sentence by speaking) -----------------------
# 'auto' detects your live output device and turns barge-in ON only on a PRIVATE endpoint
# (headphones / AirPods / smart-glasses / phone-with-earbuds) and OFF on open speakers, so
# Jarvis never interrupts himself. 'on'/'off' force it.
JARVIS_BARGE_IN_MODE=auto
# Remote clients (Mentra glasses, iPhone, Android) declare how you're listening since the local
# device name can't tell: glasses | phone-headphones | android-headphones | phone-speaker |
# android | headphones | speakers. Blank on a local host (Windows/macOS/Linux laptop).
JARVIS_DEVICE_HINT=

# ---- Wake words -----------------------------------------------------------------------
JARVIS_WAKE_WORD_ENABLED=true
JARVIS_WAKE_WORD_ENGINE=openwakeword          # openwakeword (now) | porcupine (custom phrases)
JARVIS_WAKE_WORDS=jarvis,alfred,robbin,assist,time to work,wake up,six-one-nine
JARVIS_WAKE_WORD_THRESHOLD=0.5
JARVIS_PORCUPINE_ACCESS_KEY=                   # Picovoice key, for the custom-phrase engine

# ---- Current Priler/Jarvis reaction recordings ----------------------------------------
# Exact prerecorded reaction clips from the current upstream Priler/Jarvis voice packs.
# They are NOT general TTS: arbitrary LLM replies still use JARVIS_TTS_PROVIDER.
JARVIS_PRILER_REACTIONS=true
JARVIS_PRILER_VOICE=jarvis-remaster       # jarvis-howdy | jarvis-og | jarvis-remaster
JARVIS_PRILER_LANGUAGE=ru

# ---- Brain / OpenClaw fleet -----------------------------------------------------------
# The brain WebSocket server (`python -m jarvis.brain.server`) hosts ONE shared JarvisAgent so the
# laptop, iPhone (clients/iphone/) and Mentra glasses all reach the SAME brain + memory.
JARVIS_BRAIN_HOST=127.0.0.1
JARVIS_BRAIN_PORT=8765
JARVIS_CLIENT_HTTP_PORT=8766
JARVIS_API_AUTH_TOKEN=
JARVIS_BRAIN_WS_URL=ws://127.0.0.1:8765/voice
JARVIS_OPENCLAW_GATEWAY_URL=http://127.0.0.1:8800
JARVIS_OPENCLAW_ROUTER_AGENT=ispir

# ---- freellmapi (direct-answer LLM) ---------------------------------------------------
JARVIS_FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
JARVIS_FREELLMAPI_API_KEY=

# ---- LLM latency tuning (see docs/AUDIT.md) -------------------------------------------
JARVIS_GROQ_API_KEY=
JARVIS_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=4.0
JARVIS_LLM_FAST_MODEL=

# ======================================================================================
# Phase 3 — knowledge & channel tools. Each is OPTIONAL.
# ======================================================================================
JARVIS_VAULT_PATH=C:\Users\iamva\Documents\Obsidian Vault
JARVIS_VAULT_WRITABLE=false
JARVIS_SESSION_IDLE_RESET_MINUTES=180
JARVIS_DIRECT_SPEAK_CHANNEL_READS=false
JARVIS_MEMORY_ENABLED=true
JARVIS_MEMORY_RECALL_LIMIT=5
JARVIS_MEMORY_DIGEST_MAX=20
JARVIS_REDIS_URL=
JARVIS_MEMORY_SEMANTIC_ENABLED=true
JARVIS_PROACTIVE_ENABLED=false
JARVIS_PROACTIVE_TICK_SECONDS=300
JARVIS_PROACTIVE_QUIET_HOURS=23:00-07:00
JARVIS_PROACTIVE_DAILY_BUDGET=6
JARVIS_PROACTIVE_RELEVANCE_THRESHOLD=0.6
JARVIS_HOME_LOCATION=
JARVIS_TAVILY_API_KEY=
JARVIS_JINA_API_KEY=
JARVIS_BROWSERBASE_API_KEY=
JARVIS_BROWSERBASE_PROJECT_ID=

# ---- Telegram -------------------------------------------------------------------------
JARVIS_TELEGRAM_API_ID=
JARVIS_TELEGRAM_API_HASH=
JARVIS_TELEGRAM_SESSION=jarvis
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_DEFAULT_CHAT=
JARVIS_TELEGRAM_PHONE=
JARVIS_GIPHY_API_KEY=
JARVIS_TELEGRAM_PLAYLIST_CHAT=
JARVIS_TELEGRAM_MUSIC_TARGET=me
JARVIS_MUSIC_SOURCE=ytmusic

# ---- Phase 11: Gmail + Google Calendar -----------------------------------------------
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_GOOGLE_REFRESH_TOKEN=
JARVIS_GOOGLE_OAUTH_REDIRECT=http://127.0.0.1:8585/oauth2callback

# ---- Home Assistant -------------------------------------------------------------------
JARVIS_HA_URL=
JARVIS_HA_TOKEN=

# ---- Notion ---------------------------------------------------------------------------
JARVIS_NOTION_TOKEN=
JARVIS_NOTION_VERSION=2022-06-28
JARVIS_NOTION_TASKS_DB_ID=
JARVIS_BACKLOG_ENABLED=false
JARVIS_BACKLOG_TIME=09:30
JARVIS_BACKLOG_MAX_TASKS=2

# ---- MCP ----------------------------------------------------------------------------
JARVIS_MCP_SERVERS=

# ---- System / coding / GitHub ---------------------------------------------------------
JARVIS_SYSTEM_TOOLS_ENABLED=true
JARVIS_SYSTEM_PROTECTED_PATHS=C:\Windows,C:\Program Files,C:\Program Files (x86)
JARVIS_CODING_TOOLS_ENABLED=true
JARVIS_SKILLS_ENABLED=true
JARVIS_GIT_AUTHOR_NAME=Jarvis
JARVIS_GIT_AUTHOR_EMAIL=jarvis@vazghen.local
JARVIS_GITHUB_TOKEN=
JARVIS_GITHUB_REPO=
JARVIS_FLEET_AUTHORIZED=false

# ---- Browser --------------------------------------------------------------------------
JARVIS_BROWSER_TOOLS_ENABLED=true
JARVIS_BROWSER_HEADLESS=false
JARVIS_BROWSER_PROFILE_DIR=

# ---- Protocols ------------------------------------------------------------------------
JARVIS_PROTOCOLS_ENABLED=true
JARVIS_PROTOCOL_GOODNIGHT_PASSWORD=0000
JARVIS_PROTOCOL_PHOENIX_PASSWORD=0000
JARVIS_PROTOCOL_RAGNAROK_PASSWORD=0000
JARVIS_PROTOCOL_BACKUP_PASSWORD=0000
JARVIS_PROTOCOL_PING_PASSWORD=0000
JARVIS_PROTOCOL_DIAGNOSTICS_PASSWORD=0000
JARVIS_PROTOCOL_AUDITPACK_PASSWORD=0000
JARVIS_PROTOCOL_CHECKPOINT_PASSWORD=0000

# ---- Proactivity / push ----------------------------------------------------------------
JARVIS_SCHEDULER_DB_PATH=
JARVIS_NTFY_TOPIC=
JARVIS_NTFY_SERVER=https://ntfy.sh
JARVIS_TICKER_URL=
JARVIS_TICKER_TOKEN=

# ---- Speaker biometrics ----------------------------------------------------------------
JARVIS_SPEAKER_ID_ENABLED=false
JARVIS_SPEAKER_PROFILE_PATH=
JARVIS_SPEAKER_THRESHOLD=0.25

# ---- Multi-device routing --------------------------------------------------------------
JARVIS_AUTO_ROUTE_HEADPHONES=true
