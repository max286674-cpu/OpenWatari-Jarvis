# Jarvis configuration — copy to `.env` and fill in. All keys are prefixed JARVIS_.
# Never commit the real .env (see .gitignore).

JARVIS_ASSISTANT_NAME=Watari
JARVIS_USER_NAME=
JARVIS_USER_ADDRESS=sir
JARVIS_UNDERSTOOD_LANGUAGES=Russian,English
JARVIS_REPLY_LANGUAGE=Russian
JARVIS_USER_TZ=Europe/Minsk
JARVIS_PERSONA_FILE=jarvis.md

# ---- Voice -----------------------------------------------------------------------------
JARVIS_STT_PROVIDER=whisper
JARVIS_TTS_PROVIDER=elevenlabs
JARVIS_VOICE_LOCAL_FALLBACK=true
JARVIS_TTS_FALLBACK_PROVIDER=piper
JARVIS_STT_FALLBACK_PROVIDER=whisper
JARVIS_WHISPER_MODEL=base
JARVIS_WHISPER_LANGUAGE=ru
JARVIS_PIPER_VOICE=ru_RU-ruslan-medium
JARVIS_ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=
JARVIS_ELEVENLABS_MODEL=eleven_flash_v2_5
JARVIS_DEEPGRAM_API_KEY=
JARVIS_DEEPGRAM_MODEL=nova-3
JARVIS_DEEPGRAM_LANGUAGE=multi
JARVIS_DEEPGRAM_ENDPOINTING_MS=500

# ---- Audio -----------------------------------------------------------------------------
JARVIS_AUDIO_OUTPUT_DEVICE=
JARVIS_AUDIO_INPUT_DEVICE_NAME=
JARVIS_AUDIO_INPUT_DEVICE_INDEX=
JARVIS_BARGE_IN_MODE=auto
JARVIS_DEVICE_HINT=
JARVIS_VAD_ENABLED=true
JARVIS_VAD_CONFIDENCE=0.50
JARVIS_VAD_START_SECS=0.2
JARVIS_VAD_STOP_SECS=0.45
JARVIS_VAD_MIN_VOLUME=0.05
JARVIS_MIC_GAIN=1.0

# Russian wake-word training is a separate model; until installed use open/hot-mic mode.
JARVIS_WAKE_WORD_ENABLED=false
JARVIS_WAKE_WORD_ENGINE=openwakeword
JARVIS_WAKE_WORDS=jarvis
JARVIS_WAKE_WORD_THRESHOLD=0.32

# ---- OpenRouter: main brain + visual computer agent -----------------------------------
JARVIS_OPENROUTER_API_KEY=
JARVIS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JARVIS_LLM_PRIMARY_MODEL=qwen/qwen3-30b-a3b-instruct-2507
JARVIS_LLM_FALLBACK_MODELS=
JARVIS_COMPUTER_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
JARVIS_VISION_MODELS=qwen/qwen3-vl-30b-a3b-instruct
JARVIS_COMPUTER_MAX_STEPS=8

# Compatibility fields. If OPENROUTER_API_KEY is set, Jarvis automatically wires the existing
# OpenAI-compatible client to OpenRouter, so a separate local freellmapi server is not required.
JARVIS_LLM_BACKEND=freellmapi
JARVIS_FREELLMAPI_BASE_URL=https://openrouter.ai/api/v1
JARVIS_FREELLMAPI_API_KEY=
JARVIS_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=4.0
JARVIS_LLM_REQUEST_TIMEOUT_SECONDS=20
JARVIS_OPENCLAW_DELEGATION_ENABLED=true
JARVIS_FLEET_AUTHORIZED=false

# ---- Priler exact prerecorded reactions -----------------------------------------------
JARVIS_PRILER_REACTIONS=true
JARVIS_PRILER_VOICE=jarvis-remaster
JARVIS_PRILER_LANGUAGE=ru

# ---- Local computer / browser ---------------------------------------------------------
JARVIS_DESKTOP_TOOLS_ENABLED=true
JARVIS_BROWSER_TOOLS_ENABLED=true
JARVIS_BROWSER_HEADLESS=false
JARVIS_BROWSER_PROFILE_DIR=
JARVIS_SYSTEM_TOOLS_ENABLED=true
JARVIS_SYSTEM_PROTECTED_PATHS=C:\Windows,C:\Program Files,C:\Program Files (x86)
JARVIS_CODING_TOOLS_ENABLED=true
JARVIS_SKILLS_ENABLED=true

# ---- Memory ---------------------------------------------------------------------------
JARVIS_MEMORY_ENABLED=true
JARVIS_MEMORY_RECALL_LIMIT=5
JARVIS_MEMORY_DIGEST_MAX=20
JARVIS_SESSION_IDLE_RESET_MINUTES=180

# ---- Optional integrations ------------------------------------------------------------
JARVIS_VAULT_PATH=
JARVIS_VAULT_WRITABLE=false
JARVIS_TAVILY_API_KEY=
JARVIS_JINA_API_KEY=
JARVIS_TELEGRAM_API_ID=
JARVIS_TELEGRAM_API_HASH=
JARVIS_TELEGRAM_SESSION=jarvis
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_GOOGLE_REFRESH_TOKEN=
JARVIS_NOTION_TOKEN=
JARVIS_HA_URL=
JARVIS_HA_TOKEN=
JARVIS_MCP_SERVERS=
