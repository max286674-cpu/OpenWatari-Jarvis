# Jarvis configuration — copy to `.env` and fill in. All keys are prefixed JARVIS_.
# Never commit the real .env (see .gitignore).

# ---- Provider selection ---------------------------------------------------------------
# Quality-first defaults (recommended given a no-GPU machine + you want a great voice):
JARVIS_STT_PROVIDER=deepgram          # deepgram (cloud, accurate) | whisper | moonshine (local)
JARVIS_TTS_PROVIDER=elevenlabs        # elevenlabs (the Jarvis voice) | piper | kokoro (local)
JARVIS_LLM_BACKEND=freellmapi         # Jarvis's OWN brain: freellmapi | ollama | openai
JARVIS_OPENCLAW_DELEGATION_ENABLED=true   # let Jarvis CONSULT the OpenClaw fleet as a tool

# ---- ElevenLabs: the voice you want Jarvis to have ------------------------------------
JARVIS_ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = lowest latency for streaming; eleven_turbo_v2_5 = a bit higher quality
JARVIS_ELEVENLABS_MODEL=eleven_flash_v2_5
JARVIS_ELEVENLABS_STREAMING=true

# ---- Deepgram: accurate streaming speech recognition ("understands me really well") ---
JARVIS_DEEPGRAM_API_KEY=
JARVIS_DEEPGRAM_MODEL=nova-3
# Multilingual understanding. Jarvis ALWAYS replies in English; this only sets which spoken
# languages he can understand. 'multi' = Deepgram nova-3 code-switch across English/French/
# German/Russian (low latency). Deepgram does NOT support Armenian, and Ukrainian isn't in 'multi'
# — to understand ALL SIX (incl. Armenian + Ukrainian) set JARVIS_STT_PROVIDER=whisper (local
# faster-whisper, auto-detect; heavier on a no-GPU CPU but covers everything).
JARVIS_DEEPGRAM_LANGUAGE=multi

# ---- Audio routing (speakers <-> headphones / AirPods) --------------------------------
# Where Jarvis plays his voice. Alias ("speakers" | "headphones" | "airpods"), a device-name
# fragment, or a numeric index. Blank = OS default. A voice command ("switch to my headphones")
# saves a preference that overrides this at next start. Input stays on the laptop mic so
# Bluetooth keeps high-quality A2DP output (using AirPods as the mic forces low-quality HFP).
JARVIS_AUDIO_OUTPUT_DEVICE=
JARVIS_AUDIO_INPUT_DEVICE=

# ---- Smart barge-in (interrupt Jarvis mid-sentence by speaking) -----------------------
# 'auto' detects your live output device and turns barge-in ON only on a PRIVATE endpoint
# (headphones / AirPods / smart-glasses / phone-with-earbuds) and OFF on open speakers, so
# Jarvis never interrupts himself. 'on'/'off' force it.
JARVIS_BARGE_IN_MODE=auto
# Remote clients (Mentra glasses, iPhone) declare how you're listening since the local device
# name can't tell: glasses | phone-headphones | phone-speaker | headphones | speakers. Blank on PC.
JARVIS_DEVICE_HINT=

# ---- Wake words -----------------------------------------------------------------------
JARVIS_WAKE_WORD_ENABLED=true
JARVIS_WAKE_WORD_ENGINE=openwakeword          # openwakeword (now) | porcupine (custom phrases)
JARVIS_WAKE_WORDS=jarvis,alfred,robbin,assist,time to work,wake up,six-one-nine
JARVIS_WAKE_WORD_THRESHOLD=0.5
JARVIS_PORCUPINE_ACCESS_KEY=                   # Picovoice key, for the custom-phrase engine

# ---- Brain / OpenClaw fleet -----------------------------------------------------------
# The brain WebSocket server (`python -m jarvis.brain.server`) hosts ONE shared JarvisAgent so the
# laptop, iPhone (clients/iphone/) and Mentra glasses all reach the SAME brain + memory.
JARVIS_BRAIN_HOST=127.0.0.1            # set 0.0.0.0 to reach it from the phone/glasses (same Wi-Fi)
JARVIS_BRAIN_PORT=8765                 # WebSocket /voice port
JARVIS_CLIENT_HTTP_PORT=8766           # serves the iPhone web client at http://<host>:8766/iphone/
JARVIS_API_AUTH_TOKEN=                 # blank = loopback only; set a bearer secret when on 0.0.0.0
JARVIS_BRAIN_WS_URL=ws://127.0.0.1:8765/voice
JARVIS_OPENCLAW_GATEWAY_URL=http://127.0.0.1:8800
JARVIS_OPENCLAW_GATEWAY_TOKEN=
JARVIS_OPENCLAW_ROUTER_AGENT=ispir

# ---- freellmapi (direct-answer LLM) ---------------------------------------------------
JARVIS_FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
JARVIS_FREELLMAPI_API_KEY=
JARVIS_FREELLMAPI_MODEL=default

# ======================================================================================
# Phase 3 — knowledge & channel tools. Each is OPTIONAL: leave a block blank and Jarvis
# just says that capability "isn't configured yet" instead of crashing.
# ======================================================================================

# ---- Obsidian vault — REQUIRED (Watari's L3 memory; READS/SEARCHES the local mirror) --
# Keep this set: it's validated at startup and Watari warns loudly if it's missing/unreadable.
JARVIS_VAULT_PATH=C:\Users\iamva\Documents\Obsidian Vault
# Let Watari WRITE notes into the vault (write_vault tool). Keep FALSE on the laptop — there the
# vault is a one-way VPS->local sync target and local edits get clobbered. Set TRUE only on the
# host that OWNS the vault (the VPS), where writes are authoritative and safe.
JARVIS_VAULT_WRITABLE=false

# ---- Session hygiene: smart reset -----------------------------------------------------
# After this many idle minutes, the brain journals the prior conversation (L2) and clears WORKING
# memory, so a fresh conversation hours later doesn't drag stale context/anaphora. Durable memory
# (L1/L2/L3) is untouched. 0 disables.
JARVIS_SESSION_IDLE_RESET_MINUTES=180

# ---- Phase 9: persistent memory (learned facts L1 + daily journal L2) ------------------
# Markdown under memory/learned and memory/journal — Jarvis remembers across restarts.
JARVIS_MEMORY_ENABLED=true
JARVIS_MEMORY_RECALL_LIMIT=5          # facts the recall tool returns
JARVIS_MEMORY_DIGEST_MAX=20           # recent learned facts injected into his system prompt
# L4 hot-cache (Phase 9b): blank = in-process cache only (still fast within a session). Point this
# at a Redis instance to share the cache across processes and survive a brain restart (24/7 win).
JARVIS_REDIS_URL=                     # e.g. redis://127.0.0.1:6379/0
# L5 semantic recall (Phase 9c): recall facts by meaning, not just keywords. Only active if a local
# embedder is installed — `uv sync` then `pip install sentence-transformers` (CPU model, ~90MB).
# Without it, recall stays keyword-only (graceful). No config needed beyond the toggle.
JARVIS_MEMORY_SEMANTIC_ENABLED=true

# ---- Phase 10: proactive engine (speak unprompted, clarify, confirm) -------------------
# OFF by default — he only volunteers things when you switch this on. A background tick weighs
# signals (routine, calendar, unread, self-health) and may speak/push within a daily budget and
# quiet hours. Modes (focus/lockdown) mute it on demand. See docs/EXPANSION-PLAN.md.
JARVIS_PROACTIVE_ENABLED=false
JARVIS_PROACTIVE_TICK_SECONDS=300
JARVIS_PROACTIVE_QUIET_HOURS=23:00-07:00     # no unprompted voice in this local-time window
JARVIS_PROACTIVE_DAILY_BUDGET=6              # max unprompted interjections per day
JARVIS_PROACTIVE_RELEVANCE_THRESHOLD=0.6     # only speak when a signal's urgency clears this
JARVIS_HOME_LOCATION=                        # default place for "weather" + the morning briefing

# ---- Web search (Tavily) --------------------------------------------------------------
JARVIS_TAVILY_API_KEY=                 # https://tavily.com -> API key

# ---- Page scrape (Jina Reader) --------------------------------------------------------
# Uses https://r.jina.ai — FREE + KEYLESS, nothing to configure. Optional key for higher limits:
JARVIS_JINA_API_KEY=                   # optional; get one free at https://jina.ai

# ---- Interactive headless browser (Browserbase; needs `uv sync --extra browse`) -------
JARVIS_BROWSERBASE_API_KEY=
JARVIS_BROWSERBASE_PROJECT_ID=

# ---- Telegram -------------------------------------------------------------------------
# Reading unread DMs needs a Telethon USER login (api id+hash from https://my.telegram.org,
# then a one-time interactive sign-in). Sending uses the bot token below.
JARVIS_TELEGRAM_API_ID=
JARVIS_TELEGRAM_API_HASH=
JARVIS_TELEGRAM_SESSION=jarvis
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_DEFAULT_CHAT=          # default chat id for "send a telegram"
JARVIS_TELEGRAM_PHONE=                 # your number (+countrycode...) for the one-time login
JARVIS_GIPHY_API_KEY=                  # optional; "@gif <query>" search falls back to Giphy's public key
# Your personal music: a Telegram chat/group where you keep audio tracks. Jarvis finds a track
# and delivers it to your phone Telegram to tap & play. Use an id, @username, or the exact title.
JARVIS_TELEGRAM_PLAYLIST_CHAT=
JARVIS_TELEGRAM_MUSIC_TARGET=me        # where the chosen track is sent ('me' = Saved Messages → phone)

# ---- Music backend for "play X" -------------------------------------------------------
# ytmusic = YouTube Music (free, music-tuned, no account) |
# telegram = your personal Telegram playlist | youtube = plain YouTube search.
JARVIS_MUSIC_SOURCE=ytmusic

# ---- Phase 11: Gmail + Google Calendar (one OAuth app) --------------------------------
# Vazghen asked to use Gmail "through an app": a real Google Cloud OAuth app. Do the one-time
# consent once (uv run python bench/google_login.py) — see that file's header for the console steps
# (enable Gmail API + Calendar API, create a Web OAuth client, add the redirect below) — then paste
# the printed refresh token here. The same app/token covers Gmail (read/draft/send) AND Calendar.
# send_email + create_event are confirm-gated. Everything degrades until these are set.
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_GOOGLE_REFRESH_TOKEN=
JARVIS_GOOGLE_OAUTH_REDIRECT=http://127.0.0.1:8585/oauth2callback   # must match the Google app

# ---- Phase 11: Home Assistant (local-first smart home) --------------------------------
# Create a long-lived access token in HA (your profile -> Security -> Long-lived access tokens) and
# point JARVIS_HA_URL at your instance. Jarvis reads states ("is the door locked?") and calls
# services (lights/scenes/climate/locks); locks/alarms/covers are confirmed first. Degrades if unset.
JARVIS_HA_URL=                        # e.g. http://homeassistant.local:8123
JARVIS_HA_TOKEN=

# ---- Phase 11: Notion (read / write / comment) ----------------------------------------
# Create an internal integration at https://www.notion.so/my-integrations, copy its secret, then
# SHARE each page/database you want Jarvis to touch with that integration (••• → Connections →
# your integration). Notion is deny-by-default: he only ever sees what you share. Writes/comments
# are confirm-gated. Degrades until set.
JARVIS_NOTION_TOKEN=                  # 'ntn_...' or 'secret_...' integration token
JARVIS_NOTION_VERSION=2022-06-28

# ---- System control (files / processes / PowerShell) ----------------------------------
JARVIS_SYSTEM_TOOLS_ENABLED=true
# Paths under these roots are refused for deletion (catastrophe guard).
JARVIS_SYSTEM_PROTECTED_PATHS=C:\Windows,C:\Program Files,C:\Program Files (x86)

# ---- Phase 13: coding & self-improvement (Git + GitHub) -------------------------------
# Jarvis can read/edit his own source, run the suite, lint, and make REVERSIBLE git commits (never
# force-push/reset — a revert is always a new commit). Secrets are hard-blocked from read/write.
# Commits + pushes are confirm-gated. To let him push: create a GitHub repo + a fine-grained PAT
# (Contents: read/write on that repo), then `git remote add origin https://<PAT>@github.com/<you>/<repo>.git`
# — see TODO-NOW.md Phase 13 for the exact steps. He commits locally (fully reversible) even with no remote.
JARVIS_CODING_TOOLS_ENABLED=true
JARVIS_SKILLS_ENABLED=true
JARVIS_GITHUB_TOKEN=                   # fine-grained PAT (only needed for guidance/automated push)
JARVIS_GITHUB_REPO=                   # owner/name, e.g. vazghen/jarvis
JARVIS_GIT_AUTHOR_NAME=Jarvis
JARVIS_GIT_AUTHOR_EMAIL=jarvis@vazghen.local

# ---- Production: arm the OpenClaw fleet consult (off by default) -----------------------
# The fleet touches shared VPS infra, so Jarvis only CONSULTS it (via ispir) when armed. Leave false
# for testing; set true for a 24/7 deployment where you want him to reach the team without asking.
JARVIS_FLEET_AUTHORIZED=false

# ---- Local visible browser (needs: uv sync --extra browse ; playwright install chromium)
JARVIS_BROWSER_TOOLS_ENABLED=true
JARVIS_BROWSER_HEADLESS=false                  # false = you can watch + finish logins
JARVIS_BROWSER_PROFILE_DIR=                    # blank = <repo>/.jarvis-browser (stays logged in)

# ---- Protocols (password-gated routines — CHANGE THESE) -------------------------------
JARVIS_PROTOCOLS_ENABLED=true
JARVIS_PROTOCOL_GOODNIGHT_PASSWORD=morpheus    # 'goodnight' -> stop Jarvis
JARVIS_PROTOCOL_PHOENIX_PASSWORD=icarus        # 'phoenix'   -> restart Jarvis
JARVIS_PROTOCOL_RAGNAROK_PASSWORD=valhalla     # 'ragnarok'  -> restart the laptop
JARVIS_PROTOCOL_BACKUP_PASSWORD=atlas          # 'backup'    -> archive Jarvis memory
JARVIS_PROTOCOL_PING_PASSWORD=hermes           # 'ping'      -> send a phone push test
JARVIS_PROTOCOL_DIAGNOSTICS_PASSWORD=ani       # 'diagnostics' -> write a local health report
JARVIS_PROTOCOL_AUDITPACK_PASSWORD=artashat    # 'auditpack'   -> archive audit logs
JARVIS_PROTOCOL_CHECKPOINT_PASSWORD=vagharshapat # 'checkpoint' -> archive non-secret context

# ---- Phase 4: proactivity & push ------------------------------------------------------
JARVIS_SCHEDULER_DB_PATH=                       # blank = <repo>/jarvis_jobs.sqlite
JARVIS_NTFY_TOPIC=                              # ntfy.sh topic for phone push (pick a unique one)
JARVIS_NTFY_SERVER=https://ntfy.sh
# Phase 4b true-24/7: one-shot/at reminders push even with the PC off (ntfy holds them server-side).
# Recurring (daily) reminders need the always-on VPS ticker — see deploy/vps/. Once deployed, set:
JARVIS_TICKER_URL=                              # e.g. http://127.0.0.1:8770 (reach VPS via tunnel)
JARVIS_TICKER_TOKEN=                            # optional bearer secret, must match the ticker

# ---- Phase 5: speaker biometrics (respond only to Vazghen's voice) --------------------
JARVIS_SPEAKER_ID_ENABLED=false                 # true after enrolling (uv sync --extra identity; bench/enroll_voice.py)
JARVIS_SPEAKER_PROFILE_PATH=                    # blank = <repo>/voiceprint.json
JARVIS_SPEAKER_THRESHOLD=0.25                   # ECAPA cosine accept threshold (raise = stricter)

# ---- Phase 6: multi-device routing ----------------------------------------------------
# Auto-route output to AirPods/headphones when connected to this laptop (barge-in then auto-on).
JARVIS_AUTO_ROUTE_HEADPHONES=true
# Remote clients (iPhone/Mentra) declare their device via the Hello frame; locally JARVIS_DEVICE_HINT
# (above) can force a kind. Set JARVIS_AUDIO_OUTPUT_DEVICE=auto to always prefer headphones.
