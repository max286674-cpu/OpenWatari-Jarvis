#!/bin/sh
# Commit gate: nothing leaves this machine unless the suite is green (same gate as deploy_vps.sh).
# Enabled once per clone:  git config core.hooksPath scripts/githooks
echo "pre-push: running the test suite (skip with --no-verify only if you mean it)"
cd "$(git rev-parse --show-toplevel)" || exit 1
uv run python -m pytest -q || { echo "pre-push: TESTS FAILED — push blocked."; exit 1; }
